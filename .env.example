# 复制为 .env 后填写（勿将 .env 发给他人）
# 以下均为可选；不配置时纯英文组走 fallback_to_english，不中断流水线

# --- 纯英文组翻译（chunk_builder 步骤 2）---
TRANSLATE_API_KEY=
TRANSLATE_BASE_URL=https://你的网关/v1
TRANSLATE_MODEL=gemini-2.5-flash

# --- 云 embedding 实验 E（embed_ingest_cloud.py）---
EMBED_API_KEY=
EMBED_BASE_URL=https://你的网关/v1
EMBED_MODEL=text-embedding-3-small

# --- 图片上下文说明（caption_images.py，可选步骤 2.5）---
# 默认 OpenAI 兼容视觉；与 TRANSLATE 可共用同一网关 KEY
CAPTION_API_KEY=
CAPTION_BASE_URL=https://你的网关/v1
CAPTION_MODEL=gemini-2.5-flash
# CAPTION_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# CAPTION_MODEL=claude-sonnet-4-20250514

# --- 生成式问答（generate_answer.py / qa_server.py · run_cs_e2e_gate --generate）---
# 只保留一组 QA_*（脚本 setdefault：同名键重复时只有第一次生效）
QA_API_KEY=
QA_BASE_URL=https://api.deepseek.com/v1
QA_MODEL=deepseek-v4-pro
# 可选 · Gemini 网关：
# QA_BASE_URL=https://你的网关/v1
# QA_MODEL=gemini-2.5-flash

# --- 代码审查（scripts/review_diff.py · 不依赖 Cursor BYOK）---
# 默认：AGICTO OpenAI 兼容 · gpt-5.1-codex-high（可与 TRANSLATE/QA 共用 KEY）
REVIEW_BACKEND=openai
REVIEW_API_KEY=
REVIEW_BASE_URL=https://api.agicto.cn/v1
REVIEW_MODEL=gpt-5.1-codex-high
# 重要 PR 可临时改：REVIEW_MODEL=claude-sonnet-3.5
# 原生 Anthropic（需 REVIEW_BACKEND=anthropic）：
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# REVIEW_MODEL=claude-sonnet-4-20250514

# --- 本地模型（可选；默认从 ModelScope 下载到 _scratch/modelscope/）---
# TRANSFORMERS_OFFLINE=1